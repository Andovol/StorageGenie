531: def clear_opened_date(db: Session, asset: Asset) -> Assertion | None:
532:     """Clear the active ``opened_date`` assertion (SG-256 D4).
533: 
534:     The asset must carry an accepted classification whose category tracks opened
535:     dates, exactly as ``store_opened_date`` requires. With no active accepted
536:     opened date this is a no-op: nothing is written and ``None`` is returned.
537:     Otherwise the existing ``_write_assertion`` path supersedes the old date with
538:     a new accepted assertion holding JSON ``null`` and records the same audit row.
539:     """
540:     category = _accepted_classification_category(db, asset.id)
541:     if category is None:
542:         raise ExpiryValidationError(
543:             "Asset must have an accepted classification before clearing an opened date"
544:         )
545:     if not category.opened_date_tracking:
546:         raise ExpiryValidationError(
547:             f"Opened-date tracking is not enabled for category: {category.slug}"
548:         )
549:     active = _active_assertion(db, asset.id, OPENED_DATE_FIELD)
550:     if active is None or active.review_state != "accepted":
551:         return None
552:     return _write_assertion(
553:         db, asset, OPENED_DATE_FIELD, None, "user", "accepted", None
554:     )
