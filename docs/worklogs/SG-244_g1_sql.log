--- schema reminder
CREATE TABLE reminder (
	id VARCHAR(36) NOT NULL, 
	household_id VARCHAR(36) NOT NULL, 
	asset_id VARCHAR(36) NOT NULL, 
	as_of_day VARCHAR(10) NOT NULL, 
	tier VARCHAR(50), 
	bucket VARCHAR(20) NOT NULL, 
	days_remaining INTEGER NOT NULL, 
	status VARCHAR(20) NOT NULL, 
	created_at DATETIME DEFAULT (CURRENT_TIMESTAMP) NOT NULL, 
	updated_at DATETIME DEFAULT (CURRENT_TIMESTAMP) NOT NULL, 
	PRIMARY KEY (id), 
	FOREIGN KEY(household_id) REFERENCES household (id) ON DELETE CASCADE, 
	FOREIGN KEY(asset_id) REFERENCES asset (id) ON DELETE CASCADE, 
	CONSTRAINT uq_reminder_asset_as_of_day UNIQUE (asset_id, as_of_day)
);
CREATE INDEX ix_reminder_household_id ON reminder (household_id);
CREATE INDEX ix_reminder_asset_id ON reminder (asset_id);
CREATE INDEX ix_reminder_status ON reminder (status);
