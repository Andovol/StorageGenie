# Gate (b) completeness cross-check — every >=40-char token, classified; a naive
# [A-Za-z0-9_-]{40,} grep matches benign git object IDs / sha256 image digests /
# notes-ref hex, so those classes are classified out rather than reported as hits:
$ python3 - <<'PY'
import re
files=["docs/worklogs/SG-055.log","docs/worklogs/SG-055_report.md","docs/worklogs/SG-055_verify.log"]
tok=re.compile(r'[A-Za-z0-9_/+=.-]{40,}')
susp=[]
for f in files:
    for i,l in enumerate(open(f),1):
        for m in tok.findall(l):
            if re.fullmatch(r'[0-9a-f]{40,64}',m): continue      # git/sha hex
            if re.fullmatch(r'[=*#_-]+',m): continue             # divider runs
            susp.append((f,i,m))
print("suspicious_non_hex_long_tokens =", len(susp))
for s in susp: print(s)
PY
suspicious_non_hex_long_tokens = 0

