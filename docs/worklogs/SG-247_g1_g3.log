$ sed -n "270,306p" backend/app/services/providers/reader.py
   270	def _recorded_spend(db: Session, household_id: str) -> float:
   271	    """Durable spend for one household in the CURRENT calendar month (SG-030 ISS-10, SG-125, SG-142).
   272	
   273	    The provider instance is rebuilt every step, so an in-process counter resets
   274	    and a monthly cap built on it can never bind across jobs. Summing the
   275	    committed `provider_call` cost rows through their jobs survives that rebuild
   276	    and is the same figure the audit trail already carries. SG-125 boxes the sum
   277	    to the current calendar month (server-local, live clock) so the cap matches
   278	    its "monthly" name: deleting old ledger rows can no longer silently loosen
   279	    the cap (a purge must never be fail-open).
   280	
   281	    SG-142 closes the join's blind spot. The chat/planning/analytics/synthesize
   282	    writers stamp `job_id=None`, and `provider_call` has no household column, so
   283	    those rows carry no household and can never satisfy the `Job` join. The cap
   284	    therefore under-counted real spend (the live read saw 0.0072005 against a
   285	    true month total of 0.01086845). This reader adds those rows as a SHARED
   286	    UNATTRIBUTED POOL boxed to the same month. It never attributes such a row to
   287	    a household by guessing; because the pool is unowned it counts against every
   288	    household reading that month, which is the fail-closed direction for a cap
   289	    (under-counting is the defect, over-counting merely refuses early). A month
   290	    with no `None`-job rows reads exactly as before.
   291	    """
   292	    month_start = _current_month_start_utc()
   293	    joined = (
   294	        db.query(func.coalesce(func.sum(ProviderCall.cost), 0.0))
   295	        .join(Job, ProviderCall.job_id == Job.id)
   296	        .filter(Job.household_id == household_id)
   297	        .filter(ProviderCall.created_at >= month_start)
   298	        .scalar()
   299	    )
   300	    unattributed = (
   301	        db.query(func.coalesce(func.sum(ProviderCall.cost), 0.0))
   302	        .filter(ProviderCall.job_id.is_(None))
   303	        .filter(ProviderCall.created_at >= month_start)
   304	        .scalar()
   305	    )
   306	    return float(joined or 0.0) + float(unattributed or 0.0)
