import importlib.util, json, sys
from pathlib import Path
from PIL import Image, ImageDraw
spec = importlib.util.spec_from_file_location("t2", "/home/andrei/StorageGenie/backend/tests/test_phase2_e2e.py")
t2 = importlib.util.module_from_spec(spec); sys.modules["t2"]=t2; spec.loader.exec_module(t2)
from fastapi.testclient import TestClient
from app.main import app
from app.config import settings
from app.services.providers import reader as reader_mod
H="01a19ca5-61fb-7e31-91a8-6ababa435aac"
im=Image.new("RGB",(640,480),"white"); d=ImageDraw.Draw(im); d.text((40,60),"J3b category proposal",fill="black"); p=Path("j3b_photo.jpg"); im.save(p,"JPEG")
payload=t2._food_output(); payload["items"][0]["category_proposed"]="food_beverages"
prov=t2.ScriptedPhase2Provider([payload])
reader_mod.provider_registry=lambda: {prov.provider_id: prov}
settings.sg_consent=True; settings.sg_provider_id=prov.provider_id; settings.sg_prompt_category="food"; settings.sg_confidence_threshold=0.9
with TestClient(app) as c:
    with p.open("rb") as fh:
        ev=c.post(f"/v1/evidence?household_id={H}",files={"file":(p.name,fh,"image/jpeg")}).json()
    j=c.post(f"/v1/imports?household_id={H}",json={"evidence_ids":[ev["id"]],"config":{}}).json()
    c.post(f"/v1/imports/{j['id']}/run?household_id={H}")
    cand=c.get(f"/v1/jobs/{j['id']}/candidates?household_id={H}").json()["items"][0]
    print("CANDIDATE_FIELDS", json.dumps({k:v["value"] if isinstance(v,dict) else v for k,v in cand["fields"].items()}))
    dec=c.post(f"/v1/candidates/{cand['id']}/decision?household_id={H}",json={"action":"accept","corrected_fields":{}}).json()
    aid=dec["asset_id"]; a=c.get(f"/v1/assets/{aid}?household_id={H}").json()
    print("ASSET_ASSERTIONS", json.dumps([(x["field_path"],x["value"],x["review_state"]) for x in a["assertions"]],indent=1))
    st=c.get(f"/v1/plugins/expiry-tracker/status?household_id={H}").json()
    print("EXPIRY_ROWS", json.dumps({"rows":[r["display_name"] for r in st["rows"]],"unresolved":[r["asset_id"] for r in st["unresolved_rows"] if r["asset_id"]==aid]}))
